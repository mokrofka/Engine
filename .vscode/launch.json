{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/bin/exe",
      "cwd": "${workspaceFolder}/bin",
      "console": "internalConsole",
    },
    {
      "name": "Comiple shaders",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/bin/compiling_shaders",
      "args": ["../assets/shaders", "../assets/shaders/compiled"],
      "cwd": "${workspaceFolder}/bin",
      "console": "internalConsole",
    },
    {
      "name": "Preprocessor",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/bin/preprocessor",
      "cwd": "${workspaceFolder}/bin",
      "console": "internalConsole",
    },
    {
      "name": "Build and Run",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/bin/exe",
      "cwd": "${workspaceFolder}/bin",
      "preLaunchTask": "Build",
      "console": "internalConsole",
    }
  ]
}
